{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "sourceMap": true,
    "declaration": true,

    "skipLibCheck": true,

    "experimentalDecorators": false,
    "useDefineForClassFields": true,
  }
}
